<Window x:Class="HsConquest.UI.MatchupOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Conquest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="40" Top="120">
    <!--
        Borderless, transparent, always-on-top window. Positioned at
        (40, 120) of the desktop by default. Two dropdowns: the user picks
        their own archetype + the opponent's archetype in-game; WR
        appears below both once they're set.
    -->
    <Border CornerRadius="10" Background="#FAFAFCEC" BorderBrush="#CFD3DA" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel MinWidth="280">
            <!-- Header: classes for both sides -->
            <TextBlock x:Name="HeaderText"
                       FontSize="11" Foreground="#555866" FontWeight="SemiBold"
                       TextAlignment="Center"
                       Text="? vs ?"/>

            <!-- My-deck dropdown -->
            <TextBlock Margin="0,8,0,2" FontSize="11" Foreground="#555866" Text="My deck"/>
            <ComboBox x:Name="MyArchetypeBox"
                      IsEditable="False"
                      SelectionChanged="OnSelectionChanged"/>

            <!-- Opponent-deck dropdown -->
            <TextBlock Margin="0,6,0,2" FontSize="11" Foreground="#555866" Text="Opponent's deck"/>
            <ComboBox x:Name="OppArchetypeBox"
                      IsEditable="False"
                      SelectionChanged="OnSelectionChanged"/>

            <!-- WR display (initially empty until both selected) -->
            <TextBlock x:Name="WrText"
                       Margin="0,12,0,0" FontSize="32" FontWeight="Bold"
                       TextAlignment="Center"
                       Foreground="#1A1D28"
                       Text=""/>
            <TextBlock x:Name="WrSubText"
                       FontSize="11" Foreground="#555866"
                       TextAlignment="Center"
                       Text=""/>
        </StackPanel>
    </Border>
</Window>
