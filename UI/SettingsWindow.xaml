<Window x:Class="HsConquest.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Conquest Helper — Settings"
        Width="560" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,4">
            HS Conquest Helper
        </TextBlock>
        <TextBlock Grid.Row="1" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,16">
            Paste your Tab-4 sync URL from hsconquest.netlify.app and click
            Reload matrix. That's it — pick both archetypes in-game from the
            overlay; no per-deck mapping needed.
        </TextBlock>

        <!-- Sync URL row -->
        <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,0,0,4">Sync URL</TextBlock>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Grid.Column="0" Padding="6"
                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
            <Button x:Name="ReloadButton" Grid.Column="1" Margin="8,0,0,0"
                    Padding="12,6" Content="Reload matrix" Click="OnReloadClick"/>
            <TextBlock x:Name="ReloadStatus" Grid.Column="2" Margin="8,0,0,0"
                       VerticalAlignment="Center" Foreground="#555"/>
        </Grid>

        <!-- Spacer (was the deck-mapping list — now removed) -->
        <Border Grid.Row="4"/>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Padding="14,6" Margin="0,0,8,0"
                    Content="Cancel" Click="OnCancelClick"/>
            <Button x:Name="SaveButton" Padding="14,6"
                    Content="Save" Background="#2A3FA7" Foreground="White" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
